{
  "name": "ddlc-together-server",
  "version": "1.0.0",
  "description": "Multiplayer server for DDLC Together",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --targets node18-win-x64 --output ../build/server-win.exe",
    "build:linux": "pkg . --targets node18-linux-x64 --output ../build/server-linux"
  },
  "pkg": {
    "assets": [
      "../client/dist/**/*"
    ],
    "scripts": [
      "server.js"
    ]
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.19.2",
    "socket.io": "4.7.5",
    "ws": "8.17.0"
  },
  "devDependencies": {
    "pkg": "5.8.1",
    "socket.io-client": "^4.8.3"
  }
}
